{
  "name": "zero-trust-sistem-nilai",
  "version": "1.0.0",
  "private": true,
  "description": "Tugas Praktikum Zero Trust Security - Sistem Nilai (NIST SP 800-207)",
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend",
    "seed": "node database/seed.js",
    "gateway": "node gateway/src/index.js",
    "nilai": "node service-nilai/src/index.js",
    "transkrip": "node service-transkrip/src/index.js",
    "frontend": "npm run dev --prefix frontend",
    "backend": "concurrently -n gateway,nilai,transkrip -c blue,green,yellow \"npm:gateway\" \"npm:nilai\" \"npm:transkrip\"",
    "dev": "concurrently -n gateway,nilai,transkrip,frontend -c blue,green,yellow,magenta \"npm:gateway\" \"npm:nilai\" \"npm:transkrip\" \"npm:frontend\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
