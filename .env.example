# Salin menjadi .env jika ingin mengubah nilai bawaan (semua opsional).
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

JWT_SECRET=ganti-dengan-secret-jwt-yang-panjang
GATEWAY_SECRET=ganti-dengan-gateway-secret
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti-dengan-client-secret

# Jam akses untuk edit/finalisasi nilai (format HH:MM, zona waktu di bawah)
ACCESS_HOUR_START=07:00
ACCESS_HOUR_END=21:00
ACCESS_TIMEZONE=Asia/Jakarta

# DEMO_MODE=true mengizinkan header X-Demo-Time (simulasi jam) dan endpoint /demo/probe.
# WAJIB false di lingkungan nyata.
DEMO_MODE=true

# Origin frontend yang diizinkan CORS (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
